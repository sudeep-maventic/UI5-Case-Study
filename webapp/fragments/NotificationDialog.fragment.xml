<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="notificationDialog"
        title="Notification Details"
        contentWidth="500px">
        <VBox class="sapUiMediumMargin">
            <Title text="{userNotifications>title}" level="H3"/>

            <ObjectStatus class="sapUiSmallMarginTop"
                text="{userNotifications>type}"
                state="{=
                    ${userNotifications>type} === 'Success' ? 'Success' :
                    ${userNotifications>type} === 'Error' ? 'Error' :
                    ${userNotifications>type} === 'Warning' ? 'Warning' :
                    'Information'}"/>
                <Label text="Message" class="sapUiMediumMarginTop"/>
                <Text text="{userNotifications>message}" wrapping="true"/>
                <Label text="Date Time" class="sapUiMediumMarginTop"/>
                <Text text="{userNotifications>timestamp}"/>
                <Label text="Status" class="sapUiMediumMarginTop"/>
                <ObjectStatus text="{= ${userNotifications>read} ? 'Read' : 'Unread'}"
                        state="{= ${userNotifications>read} ? 'Success' : 'Warning'}"/>
        </VBox>
        <beginButton>
            <Button
                text="Close"
                press=".onCloseNotification"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>