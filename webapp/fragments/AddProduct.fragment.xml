<core:FragmentDefinition 
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Add Product">
        <VBox class="sapUiMediumMargin">
            <Input placeholder="Enter Product Name" value="{addProduct>/productName}" />
            <Input placeholder="Enter Category" value="{addProduct>/category}" />
            <Input placeholder="Enter Quantity" type="Number" value="{addProduct>/quantity}" />
            <Input placeholder="Enter Price" type="Number" value="{addProduct>/price}" />
        </VBox>
        <beginButton>
            <Button text="Save" type="Emphasized" press="onSaveProduct" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>