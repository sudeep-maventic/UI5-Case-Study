<mvc:View controllerName="sudeep.inventorytransfer.controller.InventoryProducts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="Inventory">
        <content>
            <MessageStrip text="View Inventory items assigned to your warehouse"
                    type="Information"
                    showIcon="true"
                    showCloseButton="true" class="sapUiSmallMargin" />

            <HBox width="100%">
            <SearchField width="500px" search=".onSearch" liveChange=".onSearch" placeholder="Search by Product Name" class="sapUiSmallMarginTop sapUiSmallMarginBegin" />

            <Select id="categoryFilter" width="220px" selectedKey="All"
                    change=".onCategoryFilter" items="{categoryModel>/categories}" class="sapUiSmallMarginTop sapUiSmallMarginBegin">
                <core:Item key="" text="All Categories" />
                <core:Item key="{categoryModel>}" text="{categoryModel>}" />
            </Select>
            </HBox>
            
            <Table id="productsTable" items="{inventory>/products}" class="sapUiResponsiveMargin sapUiSmallMarginTop" width="80%">
                <headerToolbar>
                <Toolbar>
                    <Title text="Inventory Items" level="H2" />
                </Toolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="Product ID" />
                    </Column>
                    <Column >
                        <Text text="Product Name" />
                    </Column>
                    <Column >
                        <Text text="Category" />
                    </Column>
                    <Column >
                        <Text text="Available Quantity" />
                    </Column>
                    <Column >
                        <Text text="Unit Price" />
                    </Column>
                    <Column >
                        <Text text="Total Price"></Text>
                    </Column>
                    <Column >
                        <Text text="Stock Status" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem >
                        <cells>
                            <Text text="{inventory>productId}" />
                            <Text text="{inventory>productName}" />
                            <Text text="{inventory>category}" />
                            <Text text="{inventory>quantity}" />
                            <Text text="{inventory>price}" />
                            <Text text="{inventory>totalPrice}"/>
                            <ObjectStatus text="{inventory>status}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>