<mvc:View controllerName="sudeep.inventorytransfer.controller.WarehouseProfile"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:cards="sap.f.cards">

    <Page title="My Profile">
        <content>
            <!-- <HBox justifyContent="End">
                <Button text="Edit" type="Emphasized" press=".onEditProfilePress" visible="{= !${viewState>/editMode}}" />
            </HBox> -->
            <HBox justifyContent="Start">
            <f:Card class="sapUiMediumMarginBegin" width="800px">
                <f:content>
                    <VBox >
                        <ObjectHeader title="{profile>/oCurrentUser/id}">
                            <attributes>
                                <ObjectAttribute title="Warehouse" text="{profile>/oCurrentUser/warehouseId}" />
                                <ObjectAttribute title="Location" text="{profile>/oCurrentUser/location}" />
                            </attributes>
                        </ObjectHeader>
                        <HBox class="sapUiMediumMarginBegin sapUiSmallMarginTop">
                            <Label text="Full Name" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/name}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/name}" visible="{= ${viewState>/editMode}}" />
                        </HBox>

                        <HBox class="sapUiMediumMarginBegin sapUiSmallMarginTop">
                            <Label text="Email Address" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/email}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/email}" visible="{= ${viewState>/editMode}}" />
                        </HBox>

                        <HBox class="sapUiMediumMarginBegin sapUiSmallMarginTop">
                            <Label text="Employee Id" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/id}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/id}" visible="{= ${viewState>/editMode}}" />
                        </HBox>

                        <HBox class="sapUiMediumMarginBegin sapUiSmallMarginTop">
                            <Label text="Warehouse Id" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/warehouseId}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/warehouseId}" visible="{= ${viewState>/editMode}}" />
                        </HBox>

                        <HBox class="sapUiMediumMarginBegin sapUiSmallMarginTop">
                            <Label text="Warehouse Location" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/location}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/location}" visible="{= ${viewState>/editMode}}" />
                        </HBox>

                        <HBox class="sapUiMediumMarginBegin sapUiSmallMarginTop sapUiSmallMarginBottom">
                            <Label text="Role" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/role}" visible="{= !${viewState>/editMode}}"/>
                            <Input value="{profile>/oCurrentUser/role}" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                        
                    </VBox>
                    
                </f:content>
            </f:Card>
            </HBox>
            <HBox width="60%" justifyContent="Start" class="sapUiMediumMarginTop">                          
                <Button text="Save" type="Emphasized" press=".onSaveProfilePress" class="sapUiSmallMarginBegin sapUiMediumMarginEnd" visible="{= ${viewState>/editMode}}" />
                <Button text="Cancel" type="Default" press=".onCancelEditPress" visible="{= ${viewState>/editMode}}" />
            </HBox>
        </content>
    </Page>
</mvc:View>