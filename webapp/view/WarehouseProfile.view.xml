            <HBox justifyContent="End">
                <Button text="Edit" type="Emphasized" press=".onEditProfilePress" visible="{= !${viewState>/editMode}}" />
            </HBox>
            <f:Card class="sapUiMediumMargin" width="60%">
                <f:header>
                    <cards:Header title="{profile>/oCurrentUser/name}" subtitle="{profile>/oCurrentUser/role}" iconSrc="sap-icon://employee"></cards:Header>
                </f:header>                
                <f:content>
                    <VBox class="sapUiMediumMargin">
                        <HBox >
                            <Label text="Name" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/name}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/name}" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                        <HBox >
                            <Label text="Email" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/email}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/email}" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                        <HBox >
                            <Label text="Employee Id" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/employeeId}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/employeeId}" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                        <HBox class="sapUiMediumMarginTop">
                            <Label text="Warehouse Id" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/warehouseId}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/warehouseId}" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                        <HBox class="sapUiMediumMarginTop">
                            <Label text="Location" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/location}" visible="{= !${viewState>/editMode}}" />
                            <Input value="{profile>/oCurrentUser/location}" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                        <HBox class="sapUiMediumMarginTop">
                            <Label text="Role" class="sapUiMediumMarginEnd"/>
                            <Text text="{profile>/oCurrentUser/role}" visible="{= !${viewState>/editMode}}"/>
                            <Input value="{profile>/oCurrentUser/role}" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                        <HBox justifyContent="End" class="sapUiMediumMarginTop">                            
                            <Button text="Save" type="Emphasized" press=".onSaveProfilePress" class="sapUiMediumMarginEnd" visible="{= ${viewState>/editMode}}" />
                            <Button text="Cancel" type="Default" press=".onCancelEditPress" visible="{= ${viewState>/editMode}}" />
                        </HBox>
                    </VBox>
                </f:content>
            </f:Card>
        </content>
    </Page>
</mvc:View>