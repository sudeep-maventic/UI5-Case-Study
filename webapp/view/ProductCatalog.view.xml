<mvc:View
    controllerName="sudeep.inventorytransfer.controller.ProductCatalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="Product Catalog" showNavButton="true" navButtonPress=".onNavBack">
        <content>

            <Toolbar class="sapUiSmallMarginTop sapUiSmallMarginBegin sapUiSmallMarginEnd">
                <Title text="Available Products" level="H2"/>
                <ToolbarSpacer />
                    <SearchField width="25rem"
                        placeholder="Search by Product Name, Category"
                        liveChange=".onSearch"/>
                </Toolbar>
                <Table id="tblProductCatalog"
                class="sapUiSmallMargin"
                width="100%"
                growing="true"
                growingThreshold="10"
                items="{catalog>/products}" >
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Products" />
                            <ToolbarSpacer />
                                <ObjectStatus
                                    text="{= ${catalog>/products}.length + ' Products'}"
                                    state="Success"
                                    class="sapUiMediumMarginEnd" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column width="8rem">
                            <Text text="Product ID" />
                        </Column>
                        <Column width="18rem">
                            <Text text="Product Name" />
                        </Column>
                        <Column width="12rem">
                            <Text text="Category" />
                        </Column>
                        <Column hAlign="Center" width="8rem" >
                            <Text text="Unit Price" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Inactive">
                            <cells>
                                <ObjectIdentifier title="{catalog>productId}" />
                                <Text text="{catalog>productName}" />
                                <ObjectStatus text="{catalog>category}" />
                                <ObjectNumber number="{catalog>price}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>