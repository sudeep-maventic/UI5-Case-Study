<mvc:View controllerName="sudeep.inventorytransfer.controller.WarehouseRequests"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Product Requests" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <MessageStrip text="Review incoming product requests from warehouses."
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMargin">            
            </MessageStrip>

            <HBox class="sapUiSmallMargin">
            <SearchField width="500px"
                placeholder="Search by Request ID or Warehouse Location"
                liveChange=".onSearchRequests"
                search=".onSearchRequests"/>
            </HBox>

            <Table id="requestTable" 
                   items="{warehouseRequests>/requests}" 
                   class="sapUiResponsiveMargin" 
                   width="90%">
                <columns>
                    <Column>
                        <Text text="Request ID" />
                    </Column>
                    <Column>
                        <Text text="Warehouse Location" />
                    </Column>
                    <Column>
                        <Text text="Requested Items" />
                    </Column>
                    <Column>
                        <Text text="Status" />
                    </Column>
                    <Column>
                        <Text text="Action" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{warehouseRequests>requestId}" />
                            <Text text="{warehouseRequests>location}" />
                            <Text text="{= ${warehouseRequests>requestedItems}.length + ' Items'}" />
                            <ObjectStatus text="{warehouseRequests>status}" state="{= ${warehouseRequests>status} === 'Accepted' ? 'Success' : ${warehouseRequests>status} === 'Rejected' ? 'Error' : 'Warning'}" />
                            <HBox >
                                <Button text="View Details" icon="sap-icon://display" press=".onViewRequest" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>
    </Page>
</mvc:View>