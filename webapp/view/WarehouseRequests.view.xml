<mvc:View controllerName="sudeep.inventorytransfer.controller.WarehouseRequests"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Warehouse Requests">
        <content>
            <MessageStrip text="Manage warehouse requests and update their status"
                        type="Information"
                        showIcon="true">            
            </MessageStrip>

            <Table id="requestTable" 
                   items="{warehouseRequests>/requests}" 
                   class="sapUiResponsiveMargin" 
                   width="90%">
                <columns>
                    <Column>
                        <Text text="Request ID" />
                    </Column>
                    <Column>
                        <Text text="Location" />
                    </Column>
                    <Column>
                        <Text text="Items" />
                    </Column>
                    <Column>
                        <Text text="Status" />
                    </Column>
                    <Column>
                        <Text text="Actions" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{warehouseRequests>requestId}" />
                            <Text text="{warehouseRequests>location}" />
                            <Text text="{= ${warehouseRequests>requestedItems}.length + ' Items'}" />
                            <ObjectStatus text="{warehouseRequests>status}" state="{= ${warehouseRequests>status} === 'Accepted' ? 'Success' : ${warehouseRequests>status} === 'Rejected' ? 'Error' : 'Warning'}" />
                            <HBox >
                                <Button text="View" icon="sap-icon://display" press=".onViewRequest" />
                                <Button text="Accept" icon="sap-icon://accept" type="Accept" press=".onAcceptRequest" class="sapUiTinyMarginBegin" />
                                <Button text="Reject" icon="sap-icon://decline" type="Reject" press=".onRejectRequest" class="sapUiTinyMarginBegin" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>
    </Page>
</mvc:View>