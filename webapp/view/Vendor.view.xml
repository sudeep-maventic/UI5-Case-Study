<mvc:View controllerName="sudeep.inventorytransfer.controller.Vendor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core">
    <Page title="Supplier Portal">
        <headerContent>
            <Button press=".onNotifications" icon="sap-icon://bell" />
            <Button icon="sap-icon://log" type="Reject" press=".onLogout" />
    </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="Welcome, {dashboard>/company}" level="H2" />
                <Text text="Review warehouse requests and manage product supplies." class="sapUiSmallMarginBottom" />

                <HBox justifyContent="End" class="sapUiSmallMarginEnd">
                    <Button text="View Requests" 
                            icon="sap-icon://shipping-status"
                            type="Emphasized"
                            press=".onWarehouseRequests" />
                    <Button text="My Profile" 
                            icon="sap-icon://employee"
                            press=".onMyProfile"
                            class="sapUiTinyMarginBegin" />
                </HBox>

                
                <HBox justifyContent="SpaceAround">
                
                <GenericTile frameType="OneByOne" width="250px" header="Pending Requests" subheader="Requests awaiting your response" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/pending}" icon="sap-icon://pending"></NumericContent>
                    </TileContent>
                </GenericTile>

                <GenericTile frameType="OneByOne" width="250px" header="Approved Requests" subheader="Requests approved for supply" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/accepted}" icon="sap-icon://accept"></NumericContent>
                    </TileContent>
                </GenericTile>
            
                <GenericTile frameType="OneByOne" width="250px" header="Rejected Requests" subheader="Requests that were rejected" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/rejected}" icon="sap-icon://decline"></NumericContent>
                    </TileContent>
                </GenericTile>

                <GenericTile frameType="OneByOne" width="250px" header="Products Catalog" subheader="Products available for supply" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/products}" icon="sap-icon://product"></NumericContent>
                    </TileContent>
                </GenericTile>
                </HBox>

                <Panel backgroundDesign="Transparent" headerText="Recent Requests" class="sapUiLargeMarginTop">
                    <Table id="recentTicketsTable" items="{dashboard>/recentRequests}" class="sapUiResponsiveMargin" width="80%">
                        <columns>
                            <Column>
                                <Text text="Request ID" />
                            </Column>
                            <Column>
                                <Text text="Warehouse Location" />
                            </Column>
                            <Column>
                                <Text text="Requested Items" />
                            </Column>
                            <Column>
                                <Text text="Status" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{dashboard>requestId}" />
                                    <Text text="{dashboard>warehouseId}" />
                                    <Text text="{= ${dashboard>requestedItems}.length + ' Items' }" />
                                    <ObjectStatus text="{dashboard>status}" state="Warning" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>