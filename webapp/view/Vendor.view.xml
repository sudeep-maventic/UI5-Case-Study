<mvc:View controllerName="sudeep.inventorytransfer.controller.Vendor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:core="sap.ui.core">
    <Page title="Vendor Portal" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiLargeMargin">
                <Title text="Welcome ABC Suppliers" level="H2" />
                <Text text="Manage your products, orders and shipments" class="sapUiSmallMarginBottom" />

                
                <HBox justifyContent="SpaceAround">
                
                    <!-- Pending Tickets -->
                <GenericTile frameType="OneByOne" width="250px" header="Pending Tickets" subheader="Warehouse Requests" press=".onTicketPress" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="45" icon="sap-icon://alert"></NumericContent>
                    </TileContent>
                </GenericTile>
                <!-- Supply Products -->
                <GenericTile frameType="OneByOne" width="250px" header="Supply Products" subheader="Add products to Warehouse" press=".onSupplyPress" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="12" icon="sap-icon://order"></NumericContent>
                    </TileContent>
                </GenericTile>
            
                <!-- My Profile -->
                <GenericTile frameType="OneByOne" width="250px" header="My Profile" subheader="Manage your profile" press=".onProfilePress" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="1" icon="sap-icon://employee"></NumericContent>
                    </TileContent>
                </GenericTile>
                </HBox>

                <Panel headerText="Recent Warehouse Requests" class="sapUiLargeMarginTop">
                    <Table id="recentTicketsTable" inset="false" items="{/recentTickets}">
                        <columns>
                            <Column>
                                <Text text="Ticket ID" />
                            </Column>
                            <Column>
                                <Text text="Product Name" />
                            </Column>
                            <Column>
                                <Text text="Quantity" />
                            </Column>
                            <Column>
                                <Text text="Status" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{ticketId}" />
                                    <Text text="{productName}" />
                                    <Text text="{quantity}" />
                                    <Text text="{status}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>