<mvc:View controllerName="sudeep.inventorytransfer.controller.Vendor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core">
    <Page title="Vendor Dashboard" showNavButton="true" navButtonPress=".onNavBack">
        <MessageStrip text="View warehouse requests and manage product supplies."
                    type="Success"
                    showIcon="true"
                    class="sapUiSmallMargin"></MessageStrip>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="Welcome {dashboard>/company}" level="H2" />
                <Text text="Manage warehouse requests and supplies" class="sapUiSmallMarginBottom" />

                <HBox justifyContent="End" class="sapUiSmallMarginEnd">
                    <Button text="Warehouse Requests" 
                            icon="sap-icon://shipping-status"
                            type="Emphasized"
                            press=".onWarehouseRequests" />
                    <Button text="My Profile" 
                            icon="sap-icon://employee"
                            press=".onMyProfile"
                            class="sapUiTinyMarginBegin" />
                </HBox>

                
                <HBox justifyContent="SpaceAround">
                
                <GenericTile frameType="OneByOne" width="250px" header="Pending Requests" subheader="Awaiting vendor action" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/pending}" icon="sap-icon://pending"></NumericContent>
                    </TileContent>
                </GenericTile>

                <GenericTile frameType="OneByOne" width="250px" header="Accepted Requests" subheader="Approved requests" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/accepted}" icon="sap-icon://accept"></NumericContent>
                    </TileContent>
                </GenericTile>
            
                <GenericTile frameType="OneByOne" width="250px" header="Rejected Requests" subheader="Declined requests" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/rejected}" icon="sap-icon://decline"></NumericContent>
                    </TileContent>
                </GenericTile>

                <GenericTile frameType="OneByOne" width="250px" header="Products Offered" subheader="Available vendor catalog" class="sapUiTinyMargin">
                    <TileContent >
                        <NumericContent value="{dashboard>/products}" icon="sap-icon://product"></NumericContent>
                    </TileContent>
                </GenericTile>
                </HBox>

                <Panel backgroundDesign="Transparent" headerText="Recent Warehouse Requests" class="sapUiLargeMarginTop">
                    <Table id="recentTicketsTable" items="{dashboard>/recentRequests}" class="sapUiResponsiveMargin" width="80%">
                        <columns>
                            <Column>
                                <Text text="Request ID" />
                            </Column>
                            <Column>
                                <Text text="Warehouse" />
                            </Column>
                            <Column>
                                <Text text="Items" />
                            </Column>
                            <Column>
                                <Text text="Status" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{dashboard>requestId}" />
                                    <Text text="{dashboard>warehouseId}" />
                                    <Text text="{= ${dashboard>requestedItems}.length + ' Items' }" />
                                    <ObjectStatus text="{dashboard>status}" state="Warning" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>