<mvc:View controllerName="sudeep.inventorytransfer.controller.TransferDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="Transfer Details" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <ObjectHeader title="{transferDetails>/transferId}"
                    number="{transferDetails>/status}">
                <attributes>
                    <ObjectAttribute title="Source Warehouse"
                                    text="{transferDetails>/fromWarehouse}"></ObjectAttribute>
                    <ObjectAttribute title="Destination Warehouse"
                                    text="{transferDetails>/toWarehouse}"></ObjectAttribute>
                    <ObjectAttribute title="Transfer Date"
                                    text="{ 
                                    path: 'transferDetails>/transferDate',
                                    formatter: '.formatter.formatDate'}"></ObjectAttribute>
                </attributes>        
            </ObjectHeader>

            <Table items="{transferDetails>/items}" width="80%">
                <columns>
                    <Column>
                        <Text text="Product Id" />
                    </Column>
                    <Column>
                        <Text text="Product Name" />
                    </Column>
                    <Column>
                        <Text text="Quantity" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{transferDetails>productId}" />
                            <Text text="{transferDetails>productName}" />
                            <Text text="{transferDetails>quantity}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>