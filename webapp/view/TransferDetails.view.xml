<mvc:View xmlns:tnt="sap.tnt" controllerName="sudeep.inventorytransfer.controller.TransferDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="Transfer Details" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <ObjectHeader title="Transfer ID: {transferDetails>/transferId}"
                    number="{transferDetails>/status}">
                <attributes>
                    <ObjectAttribute title="Source Warehouse"
                                    text="{transferDetails>/fromWarehouse}"></ObjectAttribute>
                    <ObjectAttribute title="Destination Warehouse"
                                    text="{transferDetails>/toWarehouse}"></ObjectAttribute>
                    <ObjectAttribute title="Transfer Date"
                                    text="{ 
                                    path: 'transferDetails>/transferDate',
                                    formatter: '.formatter.formatDate'}"></ObjectAttribute>
                </attributes>        
            </ObjectHeader>

            <Panel class="sapUiSmallMargin">
            <Table  items="{transferDetails>/items}" showSeparators="All" width="80%">
                <headerToolbar>
                    <tnt:ToolHeader >
                        <Text text="Transferred Products"></Text>
                    </tnt:ToolHeader>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="Product Id" />
                    </Column>
                    <Column>
                        <Text text="Product Name" />
                    </Column>
                    <Column>
                        <Text text="Category" />
                    </Column>
                    <Column>
                        <Text text="Quantity" />
                    </Column>
                    <Column >
                        <Text text="Unit Price" />
                    </Column>
                    <Column >
                        <Text text="Total Price" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{transferDetails>productId}" />
                            <Text text="{transferDetails>productName}" />
                            <Text text="{transferDetails>category}" />
                            <Text text="{transferDetails>quantity}" />
                            <Text text="{transferDetails>price}" />
                            <Text text="{transferDetails>totalPrice}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>