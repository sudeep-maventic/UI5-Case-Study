<mvc:View controllerName="sudeep.inventorytransfer.controller.Notifications"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f">

    <Page title="Notifications" id="notificationsPage" showNavButton="false" navButtonPress=".onNavBack">
        <content>

            <SearchField width="60%" class="sapUiMediumMargin" placeholder="Search notifications..." liveChange=".onSearch"/>

            <SegmentedButton selectionChange=".onFilterChange"
                selectedKey="All"
                class="sapUiSmallMarginBegin">
                <items>
                    <SegmentedButtonItem key="All" text="All"/>
                    <SegmentedButtonItem key="Read" text="Read"/>
                    <SegmentedButtonItem key="Unread" text="Unread"/>
                </items>
            </SegmentedButton>

            <List id="notificationsList"
                items="{userNotifications>/notifications}"
                noDataText="No Notifications found"
                itemPress=".onNotificationPress"
                mode="None"
                class="sapUiMediumMarginTop">

                <ObjectListItem title="{userNotifications>title}"
                                intro="{userNotifications>date}"
                                number="{userNotifications>type}"
                                type="Active">
                        <attributes>
                            <ObjectAttribute text="{userNotifications>message}" />
                        </attributes>
                        <firstStatus>
                            <ObjectStatus text="{= ${userNotifications>read} ? 'Read' : 'Unread' }" 
                                        state="{= ${userNotifications>read} ? 'Success' : 'Warning' }"></ObjectStatus>
                        </firstStatus>
                </ObjectListItem>
                            
            </List>
        </content>
    </Page>

</mvc:View>