<mvc:View 
    xmlns:uxap="sap.uxap" 
    controllerName="sudeep.inventorytransfer.controller.VendorSupply"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="Request Details" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <ObjectHeader title="Request Id: {supply>/requestId}" number="{supply>/status}">
                <attributes>
                    <ObjectAttribute title="Warehouse" 
                                    text="{supply>/warehouseId}">
                    </ObjectAttribute>
                    <ObjectAttribute title="Requested Date" 
                                    text="{supply>/requestDate}"/>
                </attributes>
            </ObjectHeader>

            <Panel class="sapUiTinyMargin">
            <Table items="{supply>/requestedItems}" width="80%" class="sapUiSmallMargin">
                <columns>
                    <Column>
                        <Text text="Product Name"/>
                    </Column>

                    <Column>
                        <Text text="Requested Qty" />
                    </Column>

                    <Column>
                        <Text text="Quantity to Supply" />
                    </Column>

                    <Column>
                        <Text text="Unit Price" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem >
                        <cells>
                            <Text text="{supply>productName}"></Text>
                            <ObjectNumber number="{supply>quantity}"></ObjectNumber>
                            <StepInput min="0" step="1"
                                value="{supply>supplyQuantity}"
                                editable="{= ${supply>/status} === 'Pending' }"></StepInput>
                            <Input type="Number"
                                value="{supply>price}"
                                editable="{= ${supply>/status} === 'Pending'}"
                                liveChange=".onPriceChange"></Input>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            </Panel>
        </content>
        <footer>
            <Toolbar >
                <ToolbarSpacer />
                <Button text="Accept" type="Accept" press=".onAcceptRequest" visible="{= ${supply>/status} === 'Pending' }"></Button>
                <Button text="Reject" type="Reject" press=".onRejectRequest" visible="{= ${supply>/status} === 'Pending' }"></Button>
                <Button text="Supply Products" type="Accept" press=".onSupplyProducts" icon="sap-icon://shipping-status" visible="{= ${supply>/status} === 'Accepted' }"></Button>
            </Toolbar>
        </footer>
    </Page> 
</mvc:View>