<mvc:View controllerName="sudeep.inventorytransfer.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core">

    <tnt:ToolPage >

        <tnt:header>
            <tnt:ToolHeader >

                <Button icon="sap-icon://menu2" press="onMenuButtonPress"/>

                <Title text="Inventory Transfer Management" />
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <core:Fragment fragmentName="sudeep.inventorytransfer.fragments.SideNavigation" type="XML" />
        </tnt:sideContent>

        <tnt:mainContents>
            <NavContainer id="mainContainer">
                <core:Fragment id="dashboardFragment" fragmentName="sudeep.inventorytransfer.fragments.Dashboard" type="XML" />
                <core:Fragment id="inventoryFragment" fragmentName="sudeep.inventorytransfer.view.Inventory" type="XML" />
            </NavContainer>
        </tnt:mainContents>
    </tnt:ToolPage>

</mvc:View>