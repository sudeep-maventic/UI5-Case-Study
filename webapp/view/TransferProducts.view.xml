<mvc:View controllerName="sudeep.inventorytransfer.controller.TransferProducts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="Stock Transfer">
        <MessageStrip text="Create and manage stock transfer between warehouses."
                type="Information"
                showIcon="true"
                showCloseButton="true"
                class="sapUiSmallMargin">
        </MessageStrip>

        <Panel class="sapUiSmallMargin">
        <VBox>
            <HBox >
                <Label text="Source Warehouse" class="sapUiSmallMarginBegin sapUiTinyMarginTop" />
            <Select selectedKey="{transferForm>/fromWarehouse}"
                    enabled="false"
                    items="{warehouseProfile>/warehouses}"
                    class="sapUiSmallMarginBegin">
                <core:Item key="{warehouseProfile>warehouseId}" text="{warehouseProfile>location}"></core:Item>
            </Select>
            <Label text="Destination Warehouse" class="sapUiSmallMarginBegin sapUiTinyMarginTop" />
            <Select selectedKey="{transferForm>/toWarehouse}"
                    items="{warehouseProfile>/warehouses}"
                    class="sapUiSmallMarginBegin">
                <core:Item key="" text="Select Destination Warehouse"></core:Item>
                <core:Item key="{warehouseProfile>warehouseId}" text="{warehouseProfile>location}"></core:Item>
            </Select>
            </HBox>
        </VBox>
        </Panel>

        <Panel class="sapUiSmallMargin">
        <Button text="Add Transfer Item"
                    icon="sap-icon://add"
                    press=".onAddItem"
                    class="sapUiSmallMarginBegin"></Button>
        <Table items="{transferForm>/items}" width="80%" class="sapUiSmallMargin">
            <columns>
                <Column >
                    <Text text="Product"></Text>
                </Column>
                <Column >
                    <Text text="Quantity"></Text>
                </Column>
                <Column >
                    <Text text="Category"></Text>
                </Column>
                <Column >
                    <Text text="Unit Price"></Text>
                </Column>
                <Column >
                    <Text text="Actions"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Select selectedKey="{transferForm>productId}"
                            change=".onProductChange"
                            items="{warehouseProducts>/products}">
                            <core:Item key="{warehouseProducts>productId}"
                                    text="{warehouseProducts>productName}" />
                        </Select>
                        <StepInput value="{transferForm>quantity}" min="1" step="1"></StepInput>
                        <Text text="{transferForm>category}"></Text>
                        <Text text="{transferForm>price}"></Text>
                        <Button text="Remove Item" type="Negative" icon="sap-icon://delete" press=".onRemoveItem"></Button>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <HBox justifyContent="End" width="70%">
            <Button text="Submit Transfer"
                type="Emphasized"
                icon="sap-icon://paper-plane"
                press=".onSubmitTransfer"
                class="sapUiLargeMarginTop sapUiMediumMarginEnd">
        </Button>
        </HBox>

        </Panel>
    </Page>

</mvc:View>