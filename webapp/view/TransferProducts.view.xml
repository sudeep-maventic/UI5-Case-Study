<mvc:View controllerName="sudeep.inventorytransfer.controller.TransferProducts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="Transfer Products">
        <MessageStrip text="Transfer multiple products between warehouses"
                type="Information"
                showIcon="true">
        </MessageStrip>

        <VBox class="sapUiSmallMargin">
            <HBox >
                <Label text="Source Warehouse" class="sapUiSmallMarginBegin sapUiTinyMarginTop" />
            <Select selectedKey="{transferForm>/fromWarehouse}"
                    enabled="false"
                    items="{warehouseProfile>/warehouses}"
                    class="sapUiSmallMarginBegin">
                <core:Item key="{warehouseProfile>warehouseId}" text="{warehouseProfile>location}"></core:Item>
            </Select>
            <Label text="Destination Warehouse" class="sapUiSmallMarginBegin sapUiTinyMarginTop" />
            <Select selectedKey="{transferForm>/toWarehouse}"
                    items="{warehouseProfile>/warehouses}"
                    class="sapUiSmallMarginBegin">
                <core:Item key="" text="Select Location"></core:Item>
                <core:Item key="{warehouseProfile>warehouseId}" text="{warehouseProfile>location}"></core:Item>
            </Select>
            </HBox>

            <Button text="Add Item"
                    icon="sap-icon://add"
                    press=".onAddItem"
                    class="sapUiSmallMarginBegin"></Button>

            <HBox justifyContent="End" width="70%">
        <Button text="Submit Transfer"
                press=".onSubmitTransfer"
                class="sapUiSmallMarginTop sapUiLargeMarginEnd">
        </Button>
        </HBox>
        </VBox>

        <Table items="{transferForm>/items}" width="80%" class="sapUiSmallMargin">
            <columns>
                <Column >
                    <Text text="Product"></Text>
                </Column>
                <Column >
                    <Text text="Quantity"></Text>
                </Column>
                <Column >
                    <Text text="Action"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Select selectedKey="{transferForm>productId}"
                            change=".onProductChange"
                            items="{warehouseProducts>/products}">
                            <core:Item key="{warehouseProducts>productId}"
                                    text="{warehouseProducts>productName}" />
                        </Select>
                        <Input value="{transferForm>quantity}" type="Number"></Input>
                        <Button text="Remove" type="Transparent" press=".onRemoveItem"></Button>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>

</mvc:View>