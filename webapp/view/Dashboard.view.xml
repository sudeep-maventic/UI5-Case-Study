<mvc:View
    controllerName="sudeep.inventorytransfer.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
    <Page title="{i18n>TitleDashboard}">
        <content>

            <VBox class="sapUiSmallMargin">
                <Title level="H2" text="Welcome, {dashboard>/managerName}"></Title>
                <Text text="{i18n>SubtitleDashboard}" />
            </VBox>

            <layout:Grid defaultSpan="L3 M6 S12" 
                        hSpacing="1"
                        vSpacing="1" class="sapUiLargeMarginTop">
            <GenericTile class="tileLayout" header="Total Products"
                        subheader="Products in Inventory" width="200px" >
                <TileContent unit="Products">
                    <NumericContent value="{dashboard>/totalProducts}" icon="sap-icon://product"></NumericContent>
                </TileContent>
            </GenericTile>

            <GenericTile class="tileLayout" header="Pending Requests" subheader="Supplier Requests Awaiting Response" width="200px" >
                <TileContent unit="Requests">
                    <NumericContent value="{dashboard>/pendingRequests}" icon="sap-icon://pending"></NumericContent>
                </TileContent>
            </GenericTile>

            <GenericTile class="tileLayout" header="Completed Transfers" subheader="Transfers Successfully Completed" width="250px" >
                <TileContent unit="Transfers">
                    <NumericContent value="{dashboard>/completedTransfers}" icon="sap-icon://complete"></NumericContent>
                </TileContent>
            </GenericTile>

            <GenericTile class="tileLayout" header="Low Stock Items" subheader="Products Requiring Replenishment" width="200px" >
                <TileContent unit="Items">
                    <NumericContent value="{dashboard>/lowStock}" icon="sap-icon://alert"></NumericContent>
                </TileContent>
            </GenericTile>
            </layout:Grid>

            <HBox width="100%" justifyContent="SpaceAround" class="sapUiLargeMarginTop">
                <f:Card width="100%" class="sapUiResponsiveMargin">
                    <f:header>
                        <cards:Header title="Inventory Distribution by Category" subtitle="Products Available in Each Category" />
                    </f:header>

                    <f:content>
                        <viz:VizFrame id="idCategoryChart" width="400px" height="400px" vizType="stacked_column">
                            <viz:dataset>
                                <viz.data:FlattenedDataset data="{dashboard>/categories}">
                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition name="Category" value="{dashboard>category}" />
                                    </viz.data:dimensions>

                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition name="Products" value="{dashboard>count}" />
                                    </viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>

                            <viz:feeds>
                                <viz.feeds:FeedItem uid="valueAxis"
                                            type="Measure"
                                            values="Products" />
                                <viz.feeds:FeedItem uid="categoryAxis"
                                            type="Dimension"
                                            values="Category" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </f:content>
                </f:Card>

                <f:Card class="sapUiResponsiveMargin" width="100%">
                    <f:header>
                        <cards:Header title="Monthly Stock Transfers"
                                subtitle="Transfers Completed Each Month"/>
                    </f:header>

                    <f:content>
                        <viz:VizFrame id="monthlyTransferChart"
                            vizType="line"
                            width="400px"
                            height="400px">
                        <viz:dataset>
                            <viz.data:FlattenedDataset data="{dashboard>/monthlyTrend}">
                                <viz.data:dimensions>
                                    <viz.data:DimensionDefinition name="Month" value="{dashboard>month}" />
                                </viz.data:dimensions>
                                <viz.data:measures>
                                    <viz.data:MeasureDefinition name="Transfers" value="{dashboard>count}" />
                                </viz.data:measures>
                            </viz.data:FlattenedDataset>
                        </viz:dataset>

                        <viz:feeds> 
                            <viz.feeds:FeedItem uid="valueAxis"
                                type="Measure"
                                values="Transfers"/>
                            <viz.feeds:FeedItem uid="categoryAxis"
                                type="Dimension"
                                values="Month"/>
                            </viz:feeds>
                        </viz:VizFrame>
                    </f:content>
                </f:Card>
            </HBox>
        </content>
    </Page>
</mvc:View>