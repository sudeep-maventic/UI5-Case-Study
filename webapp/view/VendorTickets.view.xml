<mvc:View controllerName="sudeep.inventorytransfer.controller.VendorTickets"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
    <Page title="Pending Tickets" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiMediumMargin">
                <SearchField width="300px" placeholder="Search tickets..." liveChange=".onSearch" class="sapUiSmallMarginBottom" />

                <List id="ticketList" width="95%" items="{tickets>/tickets}" class="sapUiResponsiveMargin">
                    <ObjectListItem title="{tickets>ticketId}"
                                    intro="{tickets>location}"
                                    number="{= ${tickets>products}.length }"
                                    numberUnit="Products"
                                    type="Navigation" press=".onTicketPress">
                        <firstStatus>
                            <ObjectStatus text="{tickets>status}" state="{= ${tickets>status} === 'Pending' ? 'Warning' : (${tickets>status} === 'In Progress' ? 'Success' : 'None') }"></ObjectStatus>
                        </firstStatus>
                        <attributes>
                            <ObjectAttribute text="Requested Date: {tickets>requestedDate}" />
                        </attributes>
                    </ObjectListItem>
                </List>

