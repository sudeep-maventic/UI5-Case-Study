<mvc:View
    controllerName="sudeep.inventorytransfer.controller.VendorRequests"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="Create Purchase Requests">
        <content>
            <MessageStrip text="Create a Purchase request for products from a supplier."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom"/>

            <Panel class="sapUiSmallMargin">
            <VBox class="sapUiMediumMargin">
                <Label text="Supplier"/>
                <ComboBox selectedKey="{RequestsForm>/vendorId}"
                    change=".onVendorChange"
                    items="{vendorList>/vendors}"
                    placeholder="Select a supplier">

                    <core:Item
                        key="{vendorList>vendorId}"
                        text="{vendorList>company}" />

                </ComboBox>

                <HBox class="sapUiSmallMarginTop">
                    <Button
                        text="Add Item"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddItem"/>
                    <ToolbarSpacer/>
                    <Button
                        class="sapUiLargeMarginBegin"
                        text="Submit Purchase Request"
                        icon="sap-icon://paper-plane"
                        type="Accept"
                        press=".onSubmitRequest"/>
                </HBox>
            </VBox>
            </Panel>

            <Table id="vendorRequestTable"
                noDataText="Click 'Add Item' to create a product request"
                items="{RequestsForm>/requestedItems}"
                class="sapUiMediumMargin">
                <columns>

                    <Column width="6rem">
                        <Text text="Product ID"/>
                    </Column>

                    <Column width="15rem">
                        <Text text="Product Name"/>
                    </Column>

                    <Column width="10rem">
                        <Text text="Category"/>
                    </Column>

                    <Column width="8rem">
                        <Text text="Quantity"/>
                    </Column>

                    <Column width="6rem">
                        <Text text="Actions"/>
                    </Column>

                </columns>
                <items>
                    <ColumnListItem>
                        <cells>

                            <Text text="{RequestsForm>productId}"/>


                            <Input value="{RequestsForm>productName}" 
                                    placeholder="Enter Product Name"
                                    type="Text" />

                            <Input value="{RequestsForm>category}"
                                    placeholder="Enter Category"
                                    type="Text" />

                            <Input value="{RequestsForm>quantity}"
                                type="Number"/>

                            <Button icon="sap-icon://delete"
                                type="Reject"
                                press=".onRemoveItem"/>

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

        </content>
    </Page>
</mvc:View>