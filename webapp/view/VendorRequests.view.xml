<mvc:View
    controllerName="sudeep.inventorytransfer.controller.VendorRequests"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="Vendor Requests">

        <content>

            <MessageStrip
                text="Create Product Requests"
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom"/>

            <VBox class="sapUiMediumMargin">

                <Label text="Select Vendor"/>

                <ComboBox
                    selectedKey="{vendorRequestsForm>/vendorId}"
                    change=".onVendorChange"
                    items="{'vendors>/vendors'}">

                    <core:Item
                        key="{vendors>vendorId}"
                        text="{vendors>companyName}" />

                </ComboBox>

                <HBox class="sapUiSmallMarginTop">

                    <Button
                        text="Add Item"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddItem"/>

                    <ToolbarSpacer/>

                    <Button
                        class="sapUiLargeMarginBegin"
                        text="Submit Request"
                        icon="sap-icon://paper-plane"
                        type="Accept"
                        press=".onSubmitRequest"/>

                </HBox>

            </VBox>

            <Table
                id="vendorRequestTable"
                items="{vendorRequestsForm>/requestedItems}"
                class="sapUiMediumMargin">

                <columns>

                    <Column width="15rem">
                        <Text text="Product"/>
                    </Column>

                    <Column width="10rem">
                        <Text text="Quantity"/>
                    </Column>

                    <Column width="10rem">
                        <Text text="Price"/>
                    </Column>

                    <Column width="8rem">
                        <Text text="Action"/>
                    </Column>

                </columns>

                <items>

                    <ColumnListItem>

                        <cells>

                            <Select
                                width="100%"
                                selectedKey="{vendorRequestsForm>productId}"
                                items="{vendorProducts>/products}">

                                <core:Item
                                    key="{vendorProducts>productId}"
                                    text="{vendorProducts>productName}" />

                            </Select>

                            <Input
                                value="{vendorRequestsForm>quantity}"
                                type="Number"
                                placeholder="Qty"/>

                            <Input
                                value="{vendorRequestsForm>price}"
                                type="Number"
                                editable="false"/>

                            <Button
                                icon="sap-icon://delete"
                                type="Reject"
                                press=".onRemoveItem"/>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </content>

    </Page>

</mvc:View>