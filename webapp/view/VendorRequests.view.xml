<mvc:View
    controllerName="sudeep.inventorytransfer.controller.VendorRequests"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="Create Purchase Requests">
        <content>
            <MessageStrip text="Create a Purchase request for products from a supplier."
                type="Information"
                showIcon="true"
                class="sapUiSmallMargin"/>

            <Panel class="sapUiSmallMargin">
            <VBox class="sapUiMediumMargin">
                <Label text="Supplier"/>
                <ComboBox selectedKey="{RequestsForm>/vendorId}"
                    change=".onVendorChange"
                    items="{vendorList>/vendors}"
                    placeholder="Select a supplier">

                    <core:Item
                        key="{vendorList>vendorId}"
                        text="{vendorList>company}" />

                </ComboBox>

            </VBox>
            </Panel>

            <Panel >
            <Button text="Add Item"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddItem"
                        class="sapUiSmallMarginBegin"/>
            <Table id="vendorRequestTable"
                width="80%"
                noDataText="Click 'Add Item' to create a product request"
                items="{RequestsForm>/requestedItems}"
                class="sapUiMediumMargin">
                <columns>

                    <Column width="6rem">
                        <Text text="Product ID"/>
                    </Column>

                    <Column width="15rem">
                        <Text text="Product Name"/>
                    </Column>

                    <Column width="10rem">
                        <Text text="Category"/>
                    </Column>

                    <Column width="8rem">
                        <Text text="Quantity"/>
                    </Column>

                    <Column width="6rem">
                        <Text text="Actions"/>
                    </Column>

                </columns>
                <items>
                    <ColumnListItem>
                        <cells>

                            <Text text="{RequestsForm>productId}"/>


                            <Input value="{RequestsForm>productName}" 
                                    placeholder="Enter Product Name"
                                    type="Text" />

                            <Input value="{RequestsForm>category}"
                                    placeholder="Enter Category"
                                    type="Text" />

                            <StepInput value="{RequestsForm>quantity}"
                                min="0"
                                step="1"/>

                            <Button icon="sap-icon://delete"
                                type="Reject"
                                press=".onRemoveItem"/>

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <HBox class="sapUiSmallMarginTop" justifyContent="End">
                    <Button
                        class="sapUiLargeMarginEnd"
                        text="Submit Purchase Request"
                        icon="sap-icon://paper-plane"
                        type="Accept"
                        press=".onSubmitRequest"/>
                </HBox>
            </Panel >
        </content>
    </Page>
</mvc:View>